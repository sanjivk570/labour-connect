# --- Dependencies (installed via composer / npm, never committed) ---
/node_modules
/vendor
/auth.json

# --- Build assets (generated by vite) ---
/public/build
/public/hot
/public/storage

# --- Environment & secrets ---
.env
.env.*
!.env.example
/storage/*.key
/storage/tok.txt

# --- Generated documentation ---
/storage/api-docs

# --- Local scratch / test files in storage ---
/storage/*.ps1
/storage/pail

# --- Databases ---
# database/database.sqlite is ignored by database/.gitignore (*.sqlite*)

# --- Caches & logs ---
/.phpunit.cache
.phpunit.result.cache
/storage/logs/*
/storage/framework/views/*
/bootstrap/cache/*.php
*.log
npm-debug.log
yarn-error.log

# --- Editors & IDEs ---
/.fleet
/.idea
/.nova
/.vscode
/.zed
.phpactor.json

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Homestead / Vagrant ---
Homestead.json
Homestead.yaml

